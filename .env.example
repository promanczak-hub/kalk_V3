# ── Root .env (docker-compose) ──────────────────────────────
# Kopiuj do `.env` w root projektu i wypełnij wartości.
# Te zmienne są używane przez `docker-compose.yml` (interpolacja ${VAR}).
# Backendowe i frontendowe env'y siedzą w `backend/.env` i `frontend/.env`.

# ── Supabase Postgres (direct connection for one-shot migration scripts) ──
# Connection string do Supabase Postgres. Używane przez ad-hoc skrypty
# top-level (_phase_b_apply.py, _apply_migrations.py). Codzienna praca
# z bazą idzie przez Supabase Dashboard / Supabase client SDK.
# Format: pg://<host>:5432?u=<user>&p=<password>&d=<db>
SUPABASE_PG_URL="pg://aws-1-eu-central-1.pooler.supabase.com:5432?u=postgres.gnpsdiarmwvqhqbyetce&p=<db_password>&d=postgres"

# ── Frontend build-time ─────────────────────────────────────
# URL panelu admin widoczny z przeglądarki użytkownika.
# Domyślnie wskazuje na Supabase Dashboard Table Editor dla projektu kalk_v3.
# Tab "Panel admin" w navbar otwiera ten URL w nowej karcie.
VITE_ADMIN_URL="https://supabase.com/dashboard/project/gnpsdiarmwvqhqbyetce/editor"
